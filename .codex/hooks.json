{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/log_codex_event.py\" UserPromptSubmit",
            "timeout": 30,
            "statusMessage": "Logging Codex prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/log_codex_event.py\" Stop",
            "timeout": 30,
            "statusMessage": "Logging Codex response"
          }
        ]
      }
    ]
  }
}
